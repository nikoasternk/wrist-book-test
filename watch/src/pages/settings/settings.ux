  width: 212px;
  height: 520px;
  background-color: #000000;
}

.settings-scroll {
  width: 212px;
  height: 520px;
}

.settings-content {
  width: 212px;
  padding: 36px 6px 60px 6px;
  flex-direction: column;
  align-items: center;
}

.back-btn {
  width: 200px;
  height: 76px;
  background-color: #262626;
  border-radius: 28px;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn-txt {
  color: #FFFFFF;
  font-size: 28px;
  font-weight: bold;
}

.card {
  width: 200px;
  background-color: #1C1C1C;
  border-radius: 28px;
  padding: 16px 10px;
  margin-bottom: 12px;
  flex-direction: column;
  align-items: center;
}

.card-title {
  width: 180px;
  color: #FFFFFF;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  lines: -1;
}

.preview-txt {
  font-size: 24px;
  font-weight: bold;
  margin-top: 6px;
}

.toggle-btn {
  width: 180px;
  height: 72px;
  border-radius: 24px;
  margin-top: 12px;
  justify-content: center;
  align-items: center;
}

.toggle-on {
  background-color: #0D91FF;
}

.toggle-off {
  background-color: #333333;
}

.toggle-txt {
  color: #FFFFFF;
  font-size: 26px;
  font-weight: bold;
}

.ctrl-row {
  width: 180px;
  margin-top: 12px;
  justify-content: space-between;
  align-items: center;
}

.ctrl-btn {
  width: 60px;
  height: 64px;
  background-color: #2E2E2E;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
}

.ctrl-btn-txt {
  color: #FFFFFF;
  font-size: 34px;
  font-weight: bold;
}

.ctrl-val {
  color: #4C8DFF;
  font-size: 30px;
  font-weight: bold;
}
</style>
